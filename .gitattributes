# Store text with LF line endings; check out with the platform's own.
* text=auto

# Scripts that must keep their line endings everywhere
*.sh      text eol=lf
*.command text eol=lf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

*.ico binary
*.png binary
*.onnx binary
*.tflite binary
