# Copy this file to .env and change what you need. Every line is optional.
# Full list: the Configuration section of the README.

# Gemini API key (free: https://aistudio.google.com/apikey).
# Better: run `sophia --setup`, which keeps it in the Keychain / Credential Manager.
# GEMINI_API_KEY=your-key-here

# MODEL_NAME=gemini-3.5-flash
# THINKING_LEVEL=low
# REQUEST_TIMEOUT=30

# Open some websites in a particular browser (the rest use the default one)
# SITE_BROWSERS=youtube:chrome,github:firefox

# Voice
# TTS_ENGINE=piper
# PIPER_VOICE=en_GB-jenny_dioco-medium
# PIPER_SPEED=1.0
# WAKE_THRESHOLD=0.5

# Shortcuts (alt = Option and win = Cmd on a Mac)
# HIDE_HOTKEY=ctrl+alt+h
# STOP_HOTKEY=ctrl+alt+x

# Screen control
# SCREEN_AUTONOMY=auto
# SCREEN_BLOCKED=metatrader,zerodha
